    {
      "id": "SmanLorkM9C1rUwY-pbDE",
      "type": "text",
      "x": 1018.9612786298587,
      "y": 2306.399532529159,
      "width": 1168.19921875,
      "height": 675,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
