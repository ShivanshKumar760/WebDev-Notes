      "seed": 770321298,
      "version": 813,
      "versionNonce": 259159118,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1730712071902,
      "link": null,
      "locked": false,
      "text": "This is a form now we will enter our credential \nand then will click on the continue button \nand that's it we are logged in \n\n\nnow what amazon will do is it will store the \nuser-credential cookie in the browser and \nreason for that is suppose close the tab of \namazon and after some time when we will come back\nwww.amazon.in will ask to enter the our sign in \ndetail again and to avoid that user inconvinienc \nbrowser store the book in it-self that is at client side\n\nand when user comes back again client side send the cookie \nto server so that server can validate it's the same user ",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This is a form now we will enter our credential \nand then will click on the continue button \nand that's it we are logged in \n\n\nnow what amazon will do is it will store the \nuser-credential cookie in the browser and \nreason for that is suppose close the tab of \namazon and after some time when we will come back\nwww.amazon.in will ask to enter the our sign in \ndetail again and to avoid that user inconvinienc \nbrowser store the book in it-self that is at client side\n\nand when user comes back again client side send the cookie \nto server so that server can validate it's the same user ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "qdK5pOJ0HnN7k6t20heNV",
      "type": "text",
      "x": 354.4652502307497,
      "y": 3279.241364599523,
      "width": 1980.19873046875,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
