      "versionNonce": 1017627730,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1730712283055,
      "link": null,
      "locked": false,
      "text": "Okay so till now we got to know that cookies are stored inside browser to avoid signing \nagain but how does browser figure out i need to send this perticular cookie to amazon.in \nand not facebook.com cause it's stored in browser so it get send as header so any time we \nvisit any website our browser should send all the cookie as header so how does browser differentiate\nwhich cookie to sent and which not to",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Okay so till now we got to know that cookies are stored inside browser to avoid signing \nagain but how does browser figure out i need to send this perticular cookie to amazon.in \nand not facebook.com cause it's stored in browser so it get send as header so any time we \nvisit any website our browser should send all the cookie as header so how does browser differentiate\nwhich cookie to sent and which not to",
      "autoResize": true,
      "lineHeight": 1.25
