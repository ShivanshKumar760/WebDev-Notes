      "updated": 1730714124546,
      "link": null,
      "locked": false,
      "text": "->if we dont use cookie parse we wont be able to access cookie and it will only be stored in \nrequest.header that is only in the header just like how we need to parse incomming request \nfrom client side using express.json() or express.urlencoded({extedned:true)) to make use\nof req.body similarly if we want to use req.cookies we need cookie-parser",
      "fontSize": 62.645556597625045,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "->if we dont use cookie parse we wont be able to access cookie and it will only be stored in \nrequest.header that is only in the header just like how we need to parse incomming request \nfrom client side using express.json() or express.urlencoded({extedned:true)) to make use\nof req.body similarly if we want to use req.cookies we need cookie-parser",
      "autoResize": true,
      "lineHeight": 1.25
