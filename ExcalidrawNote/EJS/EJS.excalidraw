      "boundElements": [],
      "updated": 1731636827250,
      "link": null,
      "locked": false,
      "text": "This is a express http\nserver which has two route \ndefined and those are :\nGET:/\nand \nPOST:/\n\nboth get route and post \nroute points to the same \nendpoint \n\nGET->will respond with a \nhtml page \n\nand POST will carry out \na addition operation via the \ndata received from client \nside and post it to \"/\"\nendpoint",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This is a express http\nserver which has two route \ndefined and those are :\nGET:/\nand \nPOST:/\n\nboth get route and post \nroute points to the same \nendpoint \n\nGET->will respond with a \nhtml page \n\nand POST will carry out \na addition operation via the \ndata received from client \nside and post it to \"/\"\nendpoint",
      "autoResize": true,
      "lineHeight": 1.25
    },
