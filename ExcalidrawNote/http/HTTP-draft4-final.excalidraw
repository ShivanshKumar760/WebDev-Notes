      "text": "Now lets talk about some un-similarities b/w createServer of node:http and express\n",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Now lets talk about some un-similarities b/w createServer of node:http and express\n",
      "autoResize": false,
