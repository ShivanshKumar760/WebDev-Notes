      "versionNonce": 24888515,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1730176691732,
      "link": null,
      "locked": false,
      "text": "Note the ipv4 address lets assume it to be :aaaa.bbbb.cccc\nNow to open the website inside our mobile head to chrome or safari and inside the search\nbar type:http://aaaa.bbbb.cccc:3000—the port number on which the file is being served on\nlocal machine->so  that’s how we can surf our website on phone while its being deployed or\ntested on local network",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Note the ipv4 address lets assume it to be :aaaa.bbbb.cccc\nNow to open the website inside our mobile head to chrome or safari and inside the search bar type:http://aaaa.bbbb.cccc:3000—the port number on which the file is being served on local machine->so  that’s how we can surf our website on phone while its being deployed or tested on local network",
      "autoResize": false,
      "lineHeight": 1.25
    },
