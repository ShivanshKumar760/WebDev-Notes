      "scale": [
        1,
        1
      ]
    },
    {
      "id": "j7AHsTpe8J87kF3vw675W",
      "type": "text",
      "x": 1097.0633505163694,
      "y": 56550.161607824906,
      "width": 1311.0928120114093,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bOE",
      "roundness": null,
      "seed": 1100690413,
      "version": 72,
      "versionNonce": 2117313123,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1730177881398,
      "link": null,
      "locked": false,
      "text": "So domain is basically nickname for ip address—hmm does that mean\nI can use ip address to access google.com –for sure lets see how :",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "So domain is basically nickname for ip address—hmm does that mean I can use ip address to access google.com –for sure lets see how :",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "oAamuFi0G6Z3unct9iNSI",
      "type": "text",
      "x": 1100.598710830636,
      "y": 56755.81730781435,
      "width": 788.4275023591208,
      "height": 141.4643519924939,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bOI",
      "roundness": null,
      "seed": 1146129485,
      "version": 118,
      "versionNonce": 96442509,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1730177898795,
      "link": null,
      "locked": false,
      "text": "Steps to access google via ip address \n1.go to cmd\n2.type command ping google.com",
      "fontSize": 37.72382719799837,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Steps to access google via ip address \n1.go to cmd\n2.type command ping google.com",
      "autoResize": true,
      "lineHeight": 1.25
