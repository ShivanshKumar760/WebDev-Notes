      "boundElements": null,
      "updated": 1730191015879,
      "link": null,
      "locked": false,
      "text": "in order to sent html tag from server we have to set the content header \nto text/html there two ways:\n\n1.res.setHeader(\"Content-Type\",\"text/html\");\n2.res.writeHead(200,{\"Content-type\":\"text/html\"});\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "in order to sent html tag from server we have to set the content header \nto text/html there two ways:\n\n1.res.setHeader(\"Content-Type\",\"text/html\");\n2.res.writeHead(200,{\"Content-type\":\"text/html\"});\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
