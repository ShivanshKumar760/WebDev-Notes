    {
      "id": "dqt2OiisyZB_Kvla3aFdb",
      "type": "text",
      "x": 865.8283573824301,
      "y": 45307.44659628021,
      "width": 1820.2296868801723,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
