    {
      "id": "XQFCE9xn_QdOGmjmTjteq",
      "type": "text",
      "x": 664.2728679868471,
      "y": 142466.01046481854,
      "width": 1445.59912109375,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
