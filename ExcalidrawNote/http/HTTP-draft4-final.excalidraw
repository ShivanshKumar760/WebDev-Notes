    {
      "id": "7iXylBo0YKTDGwHawGAvb",
      "type": "text",
      "x": 873.0957244853569,
      "y": 64689.760202320795,
      "width": 1880.9990234375,
      "height": 585,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
