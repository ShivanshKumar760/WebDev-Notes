    {
      "id": "qXa98s746xNHW0atg--bS",
      "type": "text",
      "x": 774.5231054526337,
      "y": 34977.76925866583,
      "width": 2019.799072265625,
      "height": 900,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
