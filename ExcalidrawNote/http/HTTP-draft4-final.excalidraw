    {
      "id": "dFhIWCGIFNABJYFcBu9LO",
      "type": "text",
      "x": 335.61407730091884,
      "y": 161838.84607127338,
      "width": 1188,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
