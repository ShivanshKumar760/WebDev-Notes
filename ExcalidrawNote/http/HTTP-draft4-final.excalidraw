    {
      "id": "9P2F8MBTI26CzH7xI1WXD",
      "type": "text",
      "x": 882.2565207609898,
      "y": 39602.8792971913,
      "width": 1801.799072265625,
      "height": 495,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bNb",
      "roundness": null,
      "seed": 826546957,
      "version": 160,
      "versionNonce": 1091942563,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1730175881789,
      "link": null,
      "locked": false,
      "text": "So this is what address and port number is localhost refers to http://127.0.0.1/\nSo this is basically a url->http://127.0.0.1:3000/ but if we want to access this url \non some other device we cant cause this website is hosted on local machine to make it \navailable for other devices we have to make it accessible a local network so if we want to \nopen this website in our mobile for that our mobile and machine should be connected with \nsame wifi network \n\n\nnow in order to use a server to access website on other device using wifi \nwe cant use vs-code live server extension cause\n",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "So this is what address and port number is localhost refers to http://127.0.0.1/\nSo this is basically a url->http://127.0.0.1:3000/ but if we want to access this url \non some other device we cant cause this website is hosted on local machine to make it \navailable for other devices we have to make it accessible a local network so if we want to \nopen this website in our mobile for that our mobile and machine should be connected with \nsame wifi network \n\n\nnow in order to use a server to access website on other device using wifi \nwe cant use vs-code live server extension cause\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
