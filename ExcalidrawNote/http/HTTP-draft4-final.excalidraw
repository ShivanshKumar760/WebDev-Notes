        1,
        1
      ]
    },
    {
      "id": "QX1k_KQtb1iubScV8ltT1",
      "type": "text",
      "x": 773.7105496000981,
      "y": 76228.64706656412,
      "width": 1558.9705833474545,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bOk",
      "roundness": null,
      "seed": 1633062701,
      "version": 98,
      "versionNonce": 1076399085,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1730179063441,
      "link": null,
      "locked": false,
      "text": "In this example, the ‘Authorization’ header is used to include the\nauthentication token for the API request, while the ‘Content-Type’ header\nspecifies the format of the request payload.",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "In this example, the ‘Authorization’ header is used to include the authentication token for the API request, while the ‘Content-Type’ header specifies the format of the request payload.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "sp_OuwXdgW5DiOSAq_rKH",
      "type": "text",
      "x": 680.2662557631787,
      "y": 76607.06676920244,
      "width": 1821.598876953125,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bOl",
      "roundness": null,
      "seed": 1109496067,
      "version": 250,
      "versionNonce": 486282029,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1730179158505,
      "link": null,
      "locked": false,
      "text": "Now what is Content-type well in a request header we can define the content of response that\nis from server what response do we need like\n\n'Content-Type': 'text/plain'\n'Content-type': 'application/json'",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Now what is Content-type well in a request header we can define the content of response that\nis from server what response do we need like\n\n'Content-Type': 'text/plain'\n'Content-type': 'application/json'",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "zTQI1OUgBuX3e4lwnpThC",
      "type": "image",
      "x": 673.4393599648388,
      "y": 76947.54829057133,
      "width": 1723,
      "height": 574,
