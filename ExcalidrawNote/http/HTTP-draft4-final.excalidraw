    {
      "id": "IYQkjx5bd_phWnXPrgVFf",
      "type": "image",
      "x": 823.9117133246508,
      "y": 120214.85481665356,
      "width": 1187.783998373324,
      "height": 623.914975448863,
      "angle": 0,
      "strokeColor": "transparent",
