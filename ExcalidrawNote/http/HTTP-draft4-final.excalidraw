    {
      "id": "tH4I8kWz2k_4MrND_7AGI",
      "type": "text",
      "x": 997.89902420197,
      "y": 16959.576728894015,
      "width": 1170.399658203125,
      "height": 105,
      "angle": 0,
      "strokeColor": "#1e1e1e",
