    {
      "id": "9gv65D_vBzTEDzk2FsQhf",
      "type": "text",
      "x": 163.88336349033034,
      "y": 22133.79704718645,
      "width": 2059.39892578125,
      "height": 495,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bMa",
      "roundness": null,
      "seed": 1690261123,
      "version": 961,
      "versionNonce": 110006477,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1730173545881,
      "link": null,
      "locked": false,
      "text": "So this was all about DNS and Ip address we will discuss it further but if we have to understand \nit with a real word example \n\nsuppose we have doctor clinic in sector 47,gurgaon-plot-number:485 now for a person who is \nnew to the town giving him this address sector-47,gurgaon-plot-number:485 will be very encrypt\nin nature cause he/she will not know where is plot-number:485 cause it's not a landmark \nit'a plot number on the blurprint of the secotr 47 so instead of us providing the address using the plot\nnumber we will give him/her name of doctor clinic or hospital like name will be fortis hospital,near\nhuda city metro station\n\nNow he can ask the auto driver to take him to fortis hospital and the driver will take them ",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "So this was all about DNS and Ip address we will discuss it further but if we have to understand \nit with a real word example \n\nsuppose we have doctor clinic in sector 47,gurgaon-plot-number:485 now for a person who is \nnew to the town giving him this address sector-47,gurgaon-plot-number:485 will be very encrypt\nin nature cause he/she will not know where is plot-number:485 cause it's not a landmark \nit'a plot number on the blurprint of the secotr 47 so instead of us providing the address using the plot\nnumber we will give him/her name of doctor clinic or hospital like name will be fortis hospital,near\nhuda city metro station\n\nNow he can ask the auto driver to take him to fortis hospital and the driver will take them ",
      "autoResize": true,
      "lineHeight": 1.25
    },
