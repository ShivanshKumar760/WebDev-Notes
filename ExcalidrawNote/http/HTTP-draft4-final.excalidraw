    },
    {
      "id": "wUShJp5XhAdX5LBn7nQNd",
      "type": "text",
      "x": 710.0175559621857,
      "y": 77685.55030002736,
      "width": 1544.3992919921875,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bOn",
      "roundness": null,
      "seed": 1404085549,
      "version": 215,
      "versionNonce": 49376621,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1730179246998,
      "link": null,
      "locked": false,
      "text": "We can even set the Content-type to html to get back the html page from server\nand we will be seeing how to set the content-type in header request later on",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "We can even set the Content-type to html to get back the html page from server\nand we will be seeing how to set the content-type in header request later on",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "T3Umk9xLfo3mQLz0KN76Z",
      "type": "text",
      "x": 722.4165888482432,
      "y": 77886.79106071178,
      "width": 1542.553304055137,
      "height": 72.84486691412026,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bOo",
      "roundness": null,
      "seed": 1411344525,
      "version": 305,
      "versionNonce": 1478159149,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1730179277602,
      "link": null,
      "locked": false,
      "text": "Both query parameters and headers are important components of REST API design, as they allow you\nto pass information to the API and control its behavior in a flexible and efficient manner.",
      "fontSize": 29.137946765648103,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Both query parameters and headers are important components of REST API design, as they allow you to pass information to the API and control its behavior in a flexible and efficient manner.",
      "autoResize": false,
      "lineHeight": 1.25
    },
