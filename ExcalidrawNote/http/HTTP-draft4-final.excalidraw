    {
      "id": "jZiR5z0BTbN63ZGGzVi-v",
      "type": "text",
      "x": 583.3673833522885,
      "y": 31064.502819315498,
      "width": 1648.142862516061,
      "height": 405,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
