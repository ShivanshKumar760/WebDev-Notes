      "boundElements": null,
      "updated": 1730172384819,
      "link": null,
      "locked": false,
      "text": "So google-server\nis a large parent \ndirectory\nwhich host \nmultiple\nchild \ndirectory\n\n/->google home page\n/gmail->mail.google.com\n/meet->meet.google.com\n",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "So google-server\nis a large parent \ndirectory\nwhich host \nmultiple\nchild \ndirectory\n\n/->google home page\n/gmail->mail.google.com\n/meet->meet.google.com\n",
