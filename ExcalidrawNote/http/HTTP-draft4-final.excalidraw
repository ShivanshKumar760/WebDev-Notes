      "isDeleted": false,
      "boundElements": null,
      "updated": 1730180061236,
      "link": null,
      "locked": false,
      "text": "•        Common Status Codes:\no        200 OK: The request was successful.\no        301 Moved Permanently: The resource has been permanently moved to a new location.\no        302 Found: The resource has been temporarily moved to a new location.\no        400 Bad Request: The server could not understand the request.\no        401 Unauthorized: The client is not authorized to access the resource.\no        403 Forbidden: The client is forbidden to access the resource.\no        404 Not Found: The resource could not be found.\no        500 Internal Server Error: The server encountered an unexpected condition.\no        503 Service Unavailable: The server is temporarily unavailable\n",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "•        Common Status Codes:\no        200 OK: The request was successful.\no        301 Moved Permanently: The resource has been permanently moved to a new location.\no        302 Found: The resource has been temporarily moved to a new location.\no        400 Bad Request: The server could not understand the request.\no        401 Unauthorized: The client is not authorized to access the resource.\no        403 Forbidden: The client is forbidden to access the resource.\no        404 Not Found: The resource could not be found.\no        500 Internal Server Error: The server encountered an unexpected condition.\no        503 Service Unavailable: The server is temporarily unavailable\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
