      "boundElements": null,
      "updated": 1730175981124,
      "link": null,
      "locked": false,
      "text": "SO instead lets do one thing using node:http module lets create a server \nand host it on a local network",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SO instead lets do one thing using node:http module lets create a server \nand host it on a local network",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "2j2h0oCRwT_Ioq8xFC_XE",
      "type": "text",
      "x": 2075.1273388240943,
      "y": 40951.44194104131,
      "width": 1088.999267578125,
      "height": 450,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bNh",
      "roundness": null,
      "seed": 2036736771,
      "version": 410,
      "versionNonce": 923861411,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1730176223768,
      "link": null,
      "locked": false,
      "text": "Now dont worry about this code and \nwhat it is and how it written or what \nit's logic for now just understand inside \nnodejs we have a native http module which \nhas a createServer() function which sets up\na http server and it gives back the the response \nof plain text \n\nits hosted on localhost/local network(if wifi connecte)\non prt :3000",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Now dont worry about this code and \nwhat it is and how it written or what \nit's logic for now just understand inside \nnodejs we have a native http module which \nhas a createServer() function which sets up\na http server and it gives back the the response \nof plain text \n\nits hosted on localhost/local network(if wifi connecte)\non prt :3000",
      "autoResize": true,
      "lineHeight": 1.25
    },
