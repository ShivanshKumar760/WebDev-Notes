    {
      "id": "pZcJddZ0tIeeHeDiCFNnh",
      "type": "text",
      "x": -4920.454231566003,
      "y": 92392.05768167568,
      "width": 1069.1993408203125,
      "height": 810,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
