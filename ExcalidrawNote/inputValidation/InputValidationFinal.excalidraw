    {
      "id": "x9nLvI_L2eid8GYJkgpeF",
      "type": "text",
      "x": 2021.549154940078,
      "y": 15758.004285285086,
      "width": 1168.19921875,
      "height": 675,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bd5",
      "roundness": null,
      "seed": 1274093518,
      "version": 713,
      "versionNonce": 2087024270,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1730642971776,
      "link": null,
      "locked": false,
      "text": "so as we can see that when we logged request or req\nonto the console we can see that express-validator \nmiddleware will add express-validator context array to the \nrequest object and if we see carefully that this \nexpress-validator#context [] contains a _errors key which \nhas array value \n\nso we need to retrive that value from that\nand for that we use a in-built method for \nexpress-validator middleware and that is \n\nvalidationResult() in which we pass the request object \nas the parameter which will extract the error array aut\n\n",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "so as we can see that when we logged request or req\nonto the console we can see that express-validator \nmiddleware will add express-validator context array to the \nrequest object and if we see carefully that this \nexpress-validator#context [] contains a _errors key which \nhas array value \n\nso we need to retrive that value from that\nand for that we use a in-built method for \nexpress-validator middleware and that is \n\nvalidationResult() in which we pass the request object \nas the parameter which will extract the error array aut\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
