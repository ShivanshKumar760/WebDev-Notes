      "link": null,
      "locked": false,
      "text": "Here we will add validation for route parameter user_name to check it's a \nstring and it's not empty plus it min length is 4 and max is 32",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Here we will add validation for route parameter user_name to check it's a \nstring and it's not empty plus it min length is 4 and max is 32",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ueJOMWM7uXk0C0aLr74tE",
      "type": "text",
      "x": 1650.3640031743962,
      "y": 48608.703722805156,
      "width": 797.1995239257812,
      "height": 495,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
