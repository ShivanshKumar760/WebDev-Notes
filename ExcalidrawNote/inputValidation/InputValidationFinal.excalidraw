      "boundElements": null,
      "updated": 1730657961121,
      "link": null,
      "locked": false,
      "text": "Now using schema based validation let's turn our mock user in-memory database into \na clean code \n\n\nHow to write a schema:\n\n1.all validator function will become a key \n2.value will be set to true for the validator function which do not take parameter or argumnent \nlike notEmpty or isString and with they  have are bundled with error message we replace true\nwith a object containin errorMessage\n",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Now using schema based validation let's turn our mock user in-memory database into \na clean code \n\n\nHow to write a schema:\n\n1.all validator function will become a key \n2.value will be set to true for the validator function which do not take parameter or argumnent \nlike notEmpty or isString and with they  have are bundled with error message we replace true\nwith a object containin errorMessage\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
