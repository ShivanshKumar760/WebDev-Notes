      "updated": 1730653879251,
      "link": null,
      "locked": false,
      "text": "this validation is very clutered \nand not very clean\n\nso to avoid this cluter code and to make it \nclean we use schema",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "this validation is very clutered \nand not very clean\n\nso to avoid this cluter code and to make it \nclean we use schema",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "EwcCfZBvH3oFZm6IJ-JSQ",
      "type": "text",
      "x": -565.2626810776057,
      "y": 69495.78554579605,
      "width": 1654.4418466046723,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "beV",
      "roundness": null,
      "seed": 1835706446,
      "version": 72,
      "versionNonce": 1323141710,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1730653893715,
      "link": null,
      "locked": false,
      "text": "Schema validation in Express Validator allows you to define a structured way to\nvalidate the request data against a specific schema. This is particularly useful\nfor validating complex objects or multiple fields at once. You can use\ncheckSchema() to define the schema validation rules for your route handlers.",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Schema validation in Express Validator allows you to define a structured way to validate the request data against a specific schema. This is particularly useful for validating complex objects or multiple fields at once. You can use checkSchema() to define the schema validation rules for your route handlers.",
      "autoResize": false,
      "lineHeight": 1.25
    },
