      "seed": 1716420370,
      "version": 59,
      "versionNonce": 412826126,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1730646689313,
      "link": null,
      "locked": false,
      "text": "params(\"user_name\")\n.notEmpty()\n.withMessage(\"user name cannot be\nempty\")\n.isLength({min:4,max:32})\n.withMessage(\"User name must be atleat 5\ncharacter long and max 32 character\nlong\")\n.isString()\n.withMessage(\"User Name must be a\nstring\")",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "params(\"user_name\")\n.notEmpty()\n.withMessage(\"user name cannot be empty\")\n.isLength({min:4,max:32})\n.withMessage(\"User name must be atleat 5 character long and max 32 character long\")\n.isString()\n.withMessage(\"User Name must be a string\")",
      "autoResize": false,
      "lineHeight": 1.25
    },
