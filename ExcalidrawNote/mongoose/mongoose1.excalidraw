      "boundElements": null,
      "updated": 1731501526452,
      "link": null,
      "locked": false,
      "text": "In mongodb driver after fetching out database instance using \n.db() we use .collection() method to access collection of database\nbut in mongoose we use .model() to bind our collection with \nschema and store in the variable do that we can re use it",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "In mongodb driver after fetching out database instance using \n.db() we use .collection() method to access collection of database\nbut in mongoose we use .model() to bind our collection with \nschema and store in the variable do that we can re use it",
      "autoResize": true,
      "lineHeight": 1.25
    },
