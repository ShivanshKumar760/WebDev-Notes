      "text": "URL Module\n------------------------",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "URL Module\n------------------------",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "rp51ipcX3iAz8sgU5_VOF",
      "type": "text",
      "x": 444.83244048233126,
      "y": 72748.14899023774,
      "width": 1643.39892578125,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bH9",
      "roundness": null,
      "seed": 2065160909,
      "version": 30,
      "versionNonce": 1253412067,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1730039087895,
      "link": null,
      "locked": false,
      "text": "The url module in Node.js provides utilities for URL resolution and parsing. \nIt helps you work with URLs in a structured way, allowing you to easily manipulate \nand analyze them.",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The url module in Node.js provides utilities for URL resolution and parsing. \nIt helps you work with URLs in a structured way, allowing you to easily manipulate \nand analyze them.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "mRws7bBt8OrTYC4NT9FUa",
      "type": "text",
      "x": 482.98332616064613,
      "y": 72961.38893875941,
      "width": 1643.399169921875,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bHA",
      "roundness": null,
      "seed": 1545362925,
      "version": 24,
      "versionNonce": 963019085,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1730039143552,
      "link": null,
      "locked": false,
      "text": "1.URL class:\n->The URL class is the primary interface for working with URLs. \nIt can parse a URL string into its components and allows for manipulation of these \ncomponents.",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1.URL class:\n->The URL class is the primary interface for working with URLs. \nIt can parse a URL string into its components and allows for manipulation of these \ncomponents.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Kh3KOkmh659NLvfZO8Zk6",
      "type": "text",
      "x": 460.7500205424043,
      "y": 73213.5377658129,
      "width": 1544.3995361328125,
      "height": 540,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bHB",
      "roundness": null,
      "seed": 1623609869,
      "version": 18,
      "versionNonce": 2131267939,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1730039177930,
      "link": null,
      "locked": false,
      "text": "const { URL } = require('url');\n\nconst myURL = new URL('https://example.com:8000/path/name?query=string#hash');\n\nconsole.log(myURL.href);      \n// Outputs: 'https://example.com:8000/path/name?query=string#hash'\nconsole.log(myURL.hostname);   // Outputs: 'example.com'\nconsole.log(myURL.port);       // Outputs: '8000'\nconsole.log(myURL.pathname);   // Outputs: '/path/name'\nconsole.log(myURL.search);     // Outputs: '?query=string'\nconsole.log(myURL.hash);       // Outputs: '#hash'\n",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "const { URL } = require('url');\n\nconst myURL = new URL('https://example.com:8000/path/name?query=string#hash');\n\nconsole.log(myURL.href);      \n// Outputs: 'https://example.com:8000/path/name?query=string#hash'\nconsole.log(myURL.hostname);   // Outputs: 'example.com'\nconsole.log(myURL.port);       // Outputs: '8000'\nconsole.log(myURL.pathname);   // Outputs: '/path/name'\nconsole.log(myURL.search);     // Outputs: '?query=string'\nconsole.log(myURL.hash);       // Outputs: '#hash'\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
