      "boundElements": null,
      "updated": 1730111730976,
      "link": null,
      "locked": false,
      "text": "But if we try to create a same folder name using fs.mkdir() it \nwill give us error ",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "But if we try to create a same folder name using fs.mkdir() it \nwill give us error ",
