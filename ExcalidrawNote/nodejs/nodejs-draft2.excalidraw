      "seed": 36519725,
      "version": 709,
      "versionNonce": 1917612931,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1730127284737,
      "link": null,
      "locked": false,
      "text": "But this approach will take a lot of time we the data is very use and that's not efficient cause\nif the site is dependent on data it wont load properly like streaming a video on netlfix\nsuppose we as user requested to stream a episode of Friends if we have to wait for the whole video\nto get downloaded first and then use it that may take a lot of time as video file are lage \n\nso instead we sent chunks of data from server into buffer :basically packets which contain a chunk of\ndata and once a perticular buffer is filled that will get delivered,now combination of this buffer are stream",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "But this approach will take a lot of time we the data is very use and that's not efficient cause\nif the site is dependent on data it wont load properly like streaming a video on netlfix\nsuppose we as user requested to stream a episode of Friends if we have to wait for the whole video\nto get downloaded first and then use it that may take a lot of time as video file are lage \n\nso instead we sent chunks of data from server into buffer :basically packets which contain a chunk of\ndata and once a perticular buffer is filled that will get delivered,now combination of this buffer are stream",
      "autoResize": true,
      "lineHeight": 1.25
    },
