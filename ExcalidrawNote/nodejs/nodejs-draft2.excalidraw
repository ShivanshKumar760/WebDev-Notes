    {
      "id": "N8DaUl7YOrT9tM4yqs0jH",
      "type": "text",
      "x": -1889.7019252213884,
      "y": 143272.27771678913,
      "width": 1920.598876953125,
      "height": 315,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
