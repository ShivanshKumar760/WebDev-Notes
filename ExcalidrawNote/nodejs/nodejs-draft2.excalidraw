      "scale": [
        1,
        1
      ]
    },
    {
      "id": "qokFE8vmiknAuCTZEd7MM",
      "type": "text",
      "x": -1887.53209626123,
      "y": 141191.75170439167,
      "width": 1286.999267578125,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bKY",
      "roundness": null,
      "seed": 623787789,
      "version": 276,
      "versionNonce": 288710947,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1730126545343,
      "link": null,
      "locked": false,
      "text": "Suppose we need to fill the pool with basin water now the very \nfirst option will be to get a huge tank to fill the pool\nin one go and fill that tank completely so that we can take that \ntank and then dump the water in pool ",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Suppose we need to fill the pool with basin water now the very \nfirst option will be to get a huge tank to fill the pool\nin one go and fill that tank completely so that we can take that \ntank and then dump the water in pool ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Y3Q40d3_P8pZv5_YrNy-2",
      "type": "image",
      "x": -1899.9661540515533,
      "y": 141434.8103248835,
      "width": 1298.211266497361,
      "height": 436.6181389565116,
      "angle": 0,
      "strokeColor": "transparent",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bKZ",
      "roundness": null,
      "seed": 995784525,
      "version": 180,
      "versionNonce": 633211181,
