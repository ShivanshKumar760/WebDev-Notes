      "seed": 1287100237,
      "version": 539,
      "versionNonce": 502629379,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1730126988338,
      "link": null,
      "locked": false,
      "text": "This same logic is applicable in data suppose we are using a website now in order for that \nwebsite to load we need data now data can come in two way either whole data can be downloaded at \nonce into the browser so that website may use that data \n\nso we website needs to read  the data site will send a request to the server and data will\nget downloaded from server into the browser than we can start reading the data \n",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This same logic is applicable in data suppose we are using a website now in order for that \nwebsite to load we need data now data can come in two way either whole data can be downloaded at \nonce into the browser so that website may use that data \n\nso we website needs to read  the data site will send a request to the server and data will\nget downloaded from server into the browser than we can start reading the data \n",
      "autoResize": true,
      "lineHeight": 1.25
    },
