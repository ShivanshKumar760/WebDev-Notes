    {
      "id": "4jGdmLzc36oPYkH8P0oFU",
      "type": "text",
      "x": -1887.53209626123,
      "y": 140123.67763974157,
      "width": 1267.19921875,
      "height": 585,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bKW",
      "roundness": null,
      "seed": 547431885,
      "version": 403,
      "versionNonce": 197031235,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1730126374871,
      "link": null,
      "locked": false,
      "text": "Now lets talk about buffer and streams :\n\nIn order to understand buffer lets first take a look at Streams:\n\n\nStreams\n----------------------------------------------------\nWhat are streams:imagine we have basin of water at point a \nand pool at point b\n\n\nBasin                                              Pool\npoint A--------------------------------------------PointB",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Now lets talk about buffer and streams :\n\nIn order to understand buffer lets first take a look at Streams:\n\n\nStreams\n----------------------------------------------------\nWhat are streams:imagine we have basin of water at point a \nand pool at point b\n\n\nBasin                                              Pool\npoint A--------------------------------------------PointB",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "m9gFTiJ2M9YN5x84AEu2t",
      "type": "image",
      "x": -1922.4663949863004,
      "y": 140763.1325488884,
      "width": 1245.0879403963363,
      "height": 303.9068945425678,
      "angle": 0,
      "strokeColor": "transparent",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bKX",
