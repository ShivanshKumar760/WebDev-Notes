      "isDeleted": false,
      "boundElements": null,
      "updated": 1730108175216,
      "link": null,
      "locked": false,
      "text": "fileSystem module \n------------------------------------------",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "fileSystem module \n------------------------------------------",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "-xBHambu3z0tsQsvti0O5",
      "type": "text",
      "x": 827.9470834857218,
      "y": 88739.56467199443,
      "width": 1711.6019077149945,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bHm",
      "roundness": null,
      "seed": 1514730861,
      "version": 281,
      "versionNonce": 1234831565,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1730108236527,
      "link": null,
      "locked": false,
      "text": "The File System (fs) module in Node.js is a built-in module that provides an API for\ninteracting with the file system on your machine. It allows you to read, write,\nupdate, and delete files and directories. The fs module can operate in both\nsynchronous and asynchronous modes, providing flexibility for various use cases.",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The File System (fs) module in Node.js is a built-in module that provides an API for interacting with the file system on your machine. It allows you to read, write, update, and delete files and directories. The fs module can operate in both synchronous and asynchronous modes, providing flexibility for various use cases.",
      "autoResize": false,
      "lineHeight": 1.25
    },
