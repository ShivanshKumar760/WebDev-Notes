      "type": "text",
      "x": 810.1918016377344,
      "y": 88643.44458922397,
      "width": 831.7994995117188,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
