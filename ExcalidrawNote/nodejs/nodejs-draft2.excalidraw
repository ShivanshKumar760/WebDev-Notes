    {
      "id": "HIV6zddwmudhEeacCNJmx",
      "type": "text",
      "x": -1646.4215780592758,
      "y": 120270.23854553596,
      "width": 1306.799072265625,
      "height": 315,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
