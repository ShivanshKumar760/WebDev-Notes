    },
    {
      "id": "uG5mT8xBfaDR5U7VG2syU",
      "type": "text",
      "x": -1890.0698017203597,
      "y": 141967.14844768867,
      "width": 1425.599365234375,
      "height": 315,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bKa",
      "roundness": null,
      "seed": 1157980653,
      "version": 519,
      "versionNonce": 663634211,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1730126781620,
      "link": null,
      "locked": false,
      "text": "This approach means that we will have to wait for the water as \ntank need to fill up completely and then bought to the pool in order to \ndump that water which may  take alot of time ,so the other option\nwill be to make a stream b/w basin and pool and that stream will\ntake chunks of water and carried it to the pool in that way \nwe wont have to wait for the whole tank instead pool will start filling \nup slowly and then we can use it",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This approach means that we will have to wait for the water as \ntank need to fill up completely and then bought to the pool in order to \ndump that water which may  take alot of time ,so the other option\nwill be to make a stream b/w basin and pool and that stream will\ntake chunks of water and carried it to the pool in that way \nwe wont have to wait for the whole tank instead pool will start filling \nup slowly and then we can use it",
      "autoResize": true,
      "lineHeight": 1.25
    },
