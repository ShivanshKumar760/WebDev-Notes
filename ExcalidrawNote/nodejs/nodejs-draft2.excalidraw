    {
      "id": "sb9-3G1F2Hbo-nHimiKMK",
      "type": "text",
      "x": -1834.2091220902594,
      "y": 147761.61141434553,
      "width": 870.7310171015067,
      "height": 232.8159235085767,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
