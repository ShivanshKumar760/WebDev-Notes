    {
      "id": "N8fyjCEo3Nh4ut_APWrec",
      "type": "text",
      "x": 726.8836716811678,
      "y": 20004.86420078685,
      "width": 2078.998779296875,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bfo",
      "roundness": null,
      "seed": 1928100882,
      "version": 6,
      "versionNonce": 1518514386,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1730697274879,
      "link": null,
      "locked": false,
      "text": "An Express Router is a class in Express.js that creates modular route handlers and \nmiddleware systems. It's often called a \"mini-app\" because it's a complete routing and middleware system.",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "An Express Router is a class in Express.js that creates modular route handlers and \nmiddleware systems. It's often called a \"mini-app\" because it's a complete routing and middleware system.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "QBhn82rS9PkpKwNcbBDMC",
      "type": "text",
      "x": 753.4981873660531,
      "y": 20204.869051623344,
      "width": 1675.267845792417,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bfp",
      "roundness": null,
      "seed": 1572504014,
      "version": 124,
      "versionNonce": 998865102,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1730697299294,
      "link": null,
      "locked": false,
      "text": "The express.\nRouter(), you can organize your Express app's routing logic, allowing you to define\nspecific routes and middleware for different parts of your application, such as\nusers, products, or orders, in a more maintainable way.",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The express.\nRouter(), you can organize your Express app's routing logic, allowing you to define specific routes and middleware for different parts of your application, such as users, products, or orders, in a more maintainable way.",
      "autoResize": false,
      "lineHeight": 1.25
    },
