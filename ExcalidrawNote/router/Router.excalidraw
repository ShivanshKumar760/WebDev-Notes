    {
      "id": "apylZsF0n3PBF35fS9ipA",
      "type": "text",
      "x": 652.5663312443157,
      "y": 16256.090746583934,
      "width": 1861.399169921875,
      "height": 1035,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bfj",
      "roundness": null,
      "seed": 180553234,
      "version": 1283,
      "versionNonce": 64581134,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1730697005467,
      "link": null,
      "locked": false,
      "text": "Now as we can see within one index.js server file we have /user and /product \nroute defined and this makes our main server code kind of clutered with lot of things\nto deal and what if the route increased like suppose we are building a ecommerce \nwebsite so it will have user db ,product db ,product_review db,product_image db\n\nso now our main server will have to deal with /user,/product,/pReview and /pImage\nroute and this will reduce the  code readablity and cleanliness with code \nmodularity \n\n\nand that's why express router's where introduced they help us organise \nthe route which are perticular task like \n\nbundled all the route which are related to user and bundled all the route which are related to\nproduct seprately to maintain domain structure that user domain will be limited to \nuser and product domain will be limited to product and any change in user domain \nwill not affect product and vice versa\n\n\nSo a user domain is every thing that is related to user \n\nand product domain is everything that is related to product group them together\n",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Now as we can see within one index.js server file we have /user and /product \nroute defined and this makes our main server code kind of clutered with lot of things\nto deal and what if the route increased like suppose we are building a ecommerce \nwebsite so it will have user db ,product db ,product_review db,product_image db\n\nso now our main server will have to deal with /user,/product,/pReview and /pImage\nroute and this will reduce the  code readablity and cleanliness with code \nmodularity \n\n\nand that's why express router's where introduced they help us organise \nthe route which are perticular task like \n\nbundled all the route which are related to user and bundled all the route which are related to\nproduct seprately to maintain domain structure that user domain will be limited to \nuser and product domain will be limited to product and any change in user domain \nwill not affect product and vice versa\n\n\nSo a user domain is every thing that is related to user \n\nand product domain is everything that is related to product group them together\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
