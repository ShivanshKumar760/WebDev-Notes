      "seed": 88550947,
      "version": 507,
      "versionNonce": 1650890691,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1731262582597,
      "link": null,
      "locked": false,
      "text": "[{\n    _id:ObjectId(\"622a3bc0f493f1330ba0cd37\"),\n    title:\"Name of the wind\",\n    author:\"Patrick Rothfuss\",\n    pages:600,\n    genre:[\"fantasy\",\"magical\"],\n    rating:9\n },\n\n {\n    _id:ObjectId(\"622a3bc0f493f1330ba0cd3b\"),\n    title:\"The final Empire \",\n    author:\"Brandon  Sanderson\",\n    pages:450,\n    genre:[\"fantasy\",\"dystopian\"],\n    rating:8\n },\n\n{\n    _id:ObjectId(\"622a3bc0f493f1330ba0cd3c\"),\n    title:\"The Way of  Kings\",\n    author:\"Brandon Sanderson\",\n    pages:350,\n    genre:[\"fantasy\",\"dystopian\"],\n    rating:8\n }  \n] ",
      "fontSize": 44.550466863229516,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[{\n    _id:ObjectId(\"622a3bc0f493f1330ba0cd37\"),\n    title:\"Name of the wind\",\n    author:\"Patrick Rothfuss\",\n    pages:600,\n    genre:[\"fantasy\",\"magical\"],\n    rating:9\n },\n\n {\n    _id:ObjectId(\"622a3bc0f493f1330ba0cd3b\"),\n    title:\"The final Empire \",\n    author:\"Brandon  Sanderson\",\n    pages:450,\n    genre:[\"fantasy\",\"dystopian\"],\n    rating:8\n },\n\n{\n    _id:ObjectId(\"622a3bc0f493f1330ba0cd3c\"),\n    title:\"The Way of  Kings\",\n    author:\"Brandon Sanderson\",\n    pages:350,\n    genre:[\"fantasy\",\"dystopian\"],\n    rating:8\n }  \n] ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "obJRZNqAaxkRnwZZXs48t",
      "type": "text",
      "x": -520.7540345013477,
      "y": 88749.41854828747,
      "width": 2692.052625558987,
      "height": 294.14928816165775,
      "angle": 0,
      "strokeColor": "#1e1e1e",
