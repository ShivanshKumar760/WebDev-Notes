      "type": "text",
      "x": -411.3235403032532,
      "y": 76964.12730385922,
      "width": 2098.79833984375,
      "height": 270,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
