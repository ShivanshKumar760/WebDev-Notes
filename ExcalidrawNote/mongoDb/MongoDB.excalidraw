    {
      "id": "8k1iUHFSWTu9RY_j0rCYt",
      "type": "text",
      "x": 88.17542901490867,
      "y": 41411.602774135376,
      "width": 2779.3916015625,
      "height": 855.4246776099505,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 4,
