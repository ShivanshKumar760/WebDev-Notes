      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[{\n    _id:ObjectId(\"622a3bc0f493f1330ba0cd37\"),\n    title:\"Name of the wind\",\n    author:\"Patrick Rothfuss\",\n    pages:600,\n    genre:[\"fantasy\",\"magical\"],\n    rating:9\n },\n\n {\n    _id:ObjectId(\"622a3bc0f493f1330ba0cd3b\"),\n    title:\"The final Empire \",\n    author:\"Brandon  Sanderson\",\n    pages:450,\n    genre:[\"fantasy\",\"dystopian\"],\n    rating:8\n },\n\n{\n    _id:ObjectId(\"622a3bc0f493f1330ba0cd3c\"),\n    title:\"The Way of  Kings\",\n    author:\"Brandon Sanderson\",\n    pages:350,\n    genre:[\"fantasy\",\"dystopian\"],\n    rating:8\n }  \n]",
