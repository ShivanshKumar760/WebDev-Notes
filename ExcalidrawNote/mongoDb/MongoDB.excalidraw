    {
      "id": "QylYuKPZa1Rp3krQIwYNp",
      "type": "text",
      "x": -108.68682171476848,
      "y": -711.3374848362178,
      "width": 2108.0131780425627,
      "height": 692.1180378678357,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aB",
      "roundness": null,
      "seed": 144505322,
      "version": 111,
      "versionNonce": 872607978,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1731154817036,
      "link": null,
      "locked": false,
      "text": "MongoDB Database \n-------------------------------------------------------------\nLet's get started with our databse till now our backend has server \nbut we need data to store user / client access and to solve this problem \nwe have databases and if we recall till now we have been using in-memory \ndatabase but the problem with those database are there good to store value \nand data but they dont follow the rule ACID where \"C\" stand for consistency \nand when we restart the server save data is gone and in-memory database is\nreseted to default \n\nSo we need a system which will store our data even after server is restarted and which\ncan \nbe accessed very easily",
      "fontSize": 42.591879253405274,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "MongoDB Database \n-------------------------------------------------------------\nLet's get started with our databse till now our backend has server \nbut we need data to store user / client access and to solve this problem \nwe have databases and if we recall till now we have been using in-memory \ndatabase but the problem with those database are there good to store value \nand data but they dont follow the rule ACID where \"C\" stand for consistency \nand when we restart the server save data is gone and in-memory database is\nreseted to default \n\nSo we need a system which will store our data even after server is restarted and which can \nbe accessed very easily",
      "autoResize": false,
      "lineHeight": 1.25
    },
