      "updated": 1731164445043,
      "link": null,
      "locked": false,
      "text": "These are database\nadmin,config,local\n,movie quest where\nmovie quest ave a\ncollection embedded\ncontent",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "mY4fW_iWBVhwkYnY3654A",
      "originalText": "These are database admin,config,local ,movie quest where movie quest ave a collection embedded content",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "4jasBiDid9qIxsgUIhV8M",
      "type": "text",
      "x": -410.2231143339841,
      "y": 74200.78834059436,
      "width": 2344.649169921875,
      "height": 213.15168135118438,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0T",
      "roundness": null,
      "seed": 2130604141,
      "version": 463,
      "versionNonce": 1767120461,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1731166385800,
      "link": null,
      "locked": false,
      "text": "Each collection store specificy entity like a user collection will store user's document ,\nblog collection will store blog document and comment collection will store comment's document\nFor example if i want to fetch blog document to show all blog title on my website i will ask mongodb\nto send all the document inside the Blog Posts Collection ",
      "fontSize": 42.630336270236874,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Each collection store specificy entity like a user collection will store user's document ,\nblog collection will store blog document and comment collection will store comment's document\nFor example if i want to fetch blog document to show all blog title on my website i will ask mongodb\nto send all the document inside the Blog Posts Collection ",
      "autoResize": true,
      "lineHeight": 1.25
    },
