      "boundElements": null,
      "updated": 1731318507045,
      "link": null,
      "locked": false,
      "text": "Suppose this is our collection of\ndocument ",
      "fontSize": 435.5770467122404,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Suppose this is our collection of document ",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
