      "boundElements": null,
      "updated": 1731219109827,
      "link": null,
      "locked": false,
      "text": "find() method in mongoDB\n-----------------------------------",
      "fontSize": 65.88094003554694,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "find() method in mongoDB\n-----------------------------------",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "HjFR3WEFHZEIT-N6d1Py8",
      "type": "text",
      "x": -450.8971565303176,
      "y": 85801.59395931556,
      "width": 1940.399169921875,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b14",
      "roundness": null,
      "seed": 2111057091,
      "version": 6,
      "versionNonce": 1319403725,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1731219133268,
      "link": null,
      "locked": false,
      "text": "The find() method in MongoDB (accessed via the mongosh shell) is used to query a\ncollection and retrieve documents that match certain criteria. It's one of the most commonly used \nmethods to interact with data in MongoDB.",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The find() method in MongoDB (accessed via the mongosh shell) is used to query a\ncollection and retrieve documents that match certain criteria. It's one of the most commonly used \nmethods to interact with data in MongoDB.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "0LUSyGCRLS-_IXOPWrnan",
      "type": "image",
      "x": -442.0665208065768,
      "y": 86008.76803598023,
      "width": 1424.018415034671,
      "height": 541.7108777011164,
      "angle": 0,
      "strokeColor": "transparent",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b15",
      "roundness": null,
      "seed": 739834307,
      "version": 109,
      "versionNonce": 2064528515,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1731219161418,
      "link": null,
      "locked": false,
