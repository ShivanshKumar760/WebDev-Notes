      "link": null,
      "locked": false,
      "text": "5.Now even if we dont have a database we can use that database :\"It won't get created but when \nwe will start adding document in it then it will get created but till then virtually we can switch \nto a db which dosent existt\"\n\nlike:[use myDB] now myDB dosent exist but we can still switch to it but that wont create the database \nuntil we start adding document into it .",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "5.Now even if we dont have a database we can use that database :\"It won't get created but when \nwe will start adding document in it then it will get created but till then virtually we can switch \nto a db which dosent existt\"\n\nlike:[use myDB] now myDB dosent exist but we can still switch to it but that wont create the database \nuntil we start adding document into it .",
      "autoResize": true,
      "lineHeight": 1.25
    },
