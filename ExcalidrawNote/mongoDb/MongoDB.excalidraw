    {
      "id": "foeJBsRER3lYnrSrzuxfh",
      "type": "text",
      "x": -242.53526161106163,
      "y": 71914.97006300792,
      "width": 1267.399169921875,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
