    {
      "id": "2bBDcoc52xsVq8Im20h4R",
      "type": "text",
      "x": 805.0702237635344,
      "y": 46781.0558057957,
      "width": 252.9647165255364,
      "height": 670.3169798583746,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bUW",
      "roundness": null,
      "seed": 1960499853,
      "version": 162,
      "versionNonce": 1937841411,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1730435471759,
      "link": null,
      "locked": false,
      "text": "app.get(\"/Shivansh\",(req,res)=>{\n    let len=userData.length;\n    let getRecord;\n    for(let i=0;i<len;i++)\n    {   \n        if(req.url===userData[i].userName)\n        {\n            getRecord=userData[i];\n            break;\n        }\n    }\n    res.json(getRecord);\n});\n\n\napp.get(\"/Alex\",(req,res)=>{\n    let len=userData.length;\n    let getRecord;\n    for(let i=0;i<len;i++)\n    {   \n        if(req.url===userData[i].userName)\n        {\n            getRecord=userData[i];\n            break;\n        }\n    }\n    res.json(getRecord);\n});\n\napp.get(\"/Rishi\",(req,res)=>{\n    let len=userData.length;\n    let getRecord;\n    for(let i=0;i<len;i++)\n    {   \n        if(req.url===userData[i].userName)\n        {\n            getRecord=userData[i];\n            break;\n        }\n    }\n    res.json(getRecord);\n});\n\n\n\napp.get(\"/Aaryansh\",(req,res)=>{\n    let len=userData.length;\n    let getRecord;\n    for(let i=0;i<len;i++)\n    {   \n        if(req.url===userData[i].userName)\n        {\n            getRecord=userData[i];\n            break;\n        }\n    }\n    res.json(getRecord);\n});",
      "fontSize": 9.245751446322416,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "app.get(\"/Shivansh\",(req,res)=>{\n    let len=userData.length;\n    let getRecord;\n    for(let i=0;i<len;i++)\n    {   \n        if(req.url===userData[i].userName)\n        {\n            getRecord=userData[i];\n            break;\n        }\n    }\n    res.json(getRecord);\n});\n\n\napp.get(\"/Alex\",(req,res)=>{\n    let len=userData.length;\n    let getRecord;\n    for(let i=0;i<len;i++)\n    {   \n        if(req.url===userData[i].userName)\n        {\n            getRecord=userData[i];\n            break;\n        }\n    }\n    res.json(getRecord);\n});\n\napp.get(\"/Rishi\",(req,res)=>{\n    let len=userData.length;\n    let getRecord;\n    for(let i=0;i<len;i++)\n    {   \n        if(req.url===userData[i].userName)\n        {\n            getRecord=userData[i];\n            break;\n        }\n    }\n    res.json(getRecord);\n});\n\n\n\napp.get(\"/Aaryansh\",(req,res)=>{\n    let len=userData.length;\n    let getRecord;\n    for(let i=0;i<len;i++)\n    {   \n        if(req.url===userData[i].userName)\n        {\n            getRecord=userData[i];\n            break;\n        }\n    }\n    res.json(getRecord);\n});",
      "autoResize": false,
      "lineHeight": 1.25
    },
