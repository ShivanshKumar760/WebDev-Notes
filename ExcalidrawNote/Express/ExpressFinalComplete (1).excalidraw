    {
      "type": "text",
      "version": 370,
      "versionNonce": 1721328515,
      "index": "bTl",
      "isDeleted": false,
      "id": "u8WVadY2A85IMWMfkyvX0",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1177.1364735962557,
      "y": 30855.03205025141,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "width": 871.199462890625,
      "height": 405,
      "seed": 1371720013,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1730260088437,
      "link": null,
      "locked": false,
      "fontSize": 36,
      "fontFamily": 8,
      "text": "Now as soon as we hit localhost:3000\nbrowser will show\ncannot GET/ this message is being shown\nto us cause browser by default tries\nto get data from server at this endpoint \"/\"\n\nbut since in our server we have not defined\nhow to handle this endpoint / route we \nwill get this warning",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Now as soon as we hit localhost:3000\nbrowser will show\ncannot GET/ this message is being shown\nto us cause browser by default tries\nto get data from server at this endpoint \"/\"\n\nbut since in our server we have not defined\nhow to handle this endpoint / route we \nwill get this warning",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "type": "text",
      "version": 263,
      "versionNonce": 94179459,
      "index": "bTm",
      "isDeleted": false,
      "id": "2BX05bk6CtTFOyuHRx-Oe",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 645.4849669097733,
      "y": 31493.624944145933,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "width": 1544.59912109375,
      "height": 360,
      "seed": 262339725,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1730260194844,
      "link": null,
      "locked": false,
      "fontSize": 36,
      "fontFamily": 8,
      "text": "Let's fix this by adding a route handler to \"/\" this path and attaching\nthis path to a method sent by browser:\n\nSyntax:\n\nexpress().method<get/post/put/delete>(path or route,callBackFunction(req,res){\n    //\n});",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Let's fix this by adding a route handler to \"/\" this path and attaching\nthis path to a method sent by browser:\n\nSyntax:\n\nexpress().method<get/post/put/delete>(path or route,callBackFunction(req,res){\n    //\n});",
      "autoResize": true,
      "lineHeight": 1.25
    },
