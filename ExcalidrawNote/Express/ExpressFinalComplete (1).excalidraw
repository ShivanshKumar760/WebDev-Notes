      "boundElements": null,
      "updated": 1730463454258,
      "link": null,
      "locked": false,
      "text": "The problem lies in this \nline we are using express.json\nas the body-parser to parse\nthe incomming request \npayload and express.json\nwill parse only incomming\njson request but form sents\na urlencoded type payload\n\nso for that we use :\nexpress.urlencoded()",
      "fontSize": 11.514880753788557,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The problem lies in this \nline we are using express.json\nas the body-parser to parse\nthe incomming request \npayload and express.json\nwill parse only incomming\njson request but form sents\na urlencoded type payload\n\nso for that we use :\nexpress.urlencoded()",
      "autoResize": true,
      "lineHeight": 1.25
    },
