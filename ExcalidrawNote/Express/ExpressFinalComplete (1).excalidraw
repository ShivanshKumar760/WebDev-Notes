      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 246.20138199228643,
      "y": 1167.3620167077556,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "width": 1232.599609375,
      "height": 420,
      "seed": 982794893,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1730256008538,
      "link": null,
      "locked": false,
      "fontSize": 28,
      "fontFamily": 8,
      "text": "Let's understand this with a example suppose we have a endpoint serving on\nour localhost machine and that endpoint is /fetchUser\n\nnow my bowser when to receive data from /fetchUser without giving any \nexternal data so in this case or by default also browser will send \nGET request :\n\nso in our server we will have to handle \"/fetchUser\" route with GET method\nand response back with list of user -so in our backend we will attach get method\nwith \"/fetchUser\"\n\n ",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Let's understand this with a example suppose we have a endpoint serving on\nour localhost machine and that endpoint is /fetchUser\n\nnow my bowser when to receive data from /fetchUser without giving any \nexternal data so in this case or by default also browser will send \nGET request :\n\nso in our server we will have to handle \"/fetchUser\" route with GET method\nand response back with list of user -so in our backend we will attach get method\nwith \"/fetchUser\"\n\n ",
      "autoResize": true,
      "lineHeight": 1.25
