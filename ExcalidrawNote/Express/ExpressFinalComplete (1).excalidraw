    {
      "type": "text",
      "version": 162,
      "versionNonce": 524837507,
      "index": "bT4",
      "isDeleted": false,
      "id": "x05ESVWahARVQBpq7bOOz",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 501.2789985700789,
      "y": 18700.82220025986,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "width": 1861.19921875,
      "height": 585,
      "seed": 1800647395,
      "groupIds": [],
