    },
    {
      "type": "text",
      "version": 49,
      "versionNonce": 1061822915,
      "index": "bSl",
      "isDeleted": false,
      "id": "L5v6m79A-5K1FgNIw2S8Q",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 492.5469770179626,
      "y": 2414.0298007706015,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "width": 752.5995483398438,
      "height": 45,
      "seed": 858258925,
