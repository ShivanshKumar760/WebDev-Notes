    {
      "id": "k-7Z3wQMySOLuHMeJk2Jb",
      "type": "text",
      "x": 1155.3242686083854,
      "y": 60121.70106229231,
      "width": 316.99957275390625,
      "height": 60,
      "angle": 0,
      "strokeColor": "#f08c00",
