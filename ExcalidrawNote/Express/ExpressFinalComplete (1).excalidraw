    {
      "id": "jjMBLUAz-5NukJLectZtn",
      "type": "text",
      "x": 807.627954177542,
      "y": 47555.17701409644,
      "width": 562.3117123203406,
      "height": 282.34506750648075,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bUY",
