    {
      "id": "u8IMqeqURjgk1yiBd4FD8",
      "type": "text",
      "x": 815.8103880431951,
      "y": 45307.42475701854,
      "width": 613.7996215820312,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
