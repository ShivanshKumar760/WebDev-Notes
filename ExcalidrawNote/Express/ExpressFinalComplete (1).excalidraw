      "boundElements": null,
      "updated": 1730435394926,
      "link": null,
      "locked": false,
      "text": "let userData=[\n{id:1,userName:Shivansh,userAge:19},\n{id:2,userName:Alex,userAge:19},\n{id:3,userName:Aaryansh,userAge:19},\n{id:4,userName:Rishi,userAge:19}\n]",
      "fontSize": 13.480102161577516,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "let userData=[\n{id:1,userName:Shivansh,userAge:19},\n{id:2,userName:Alex,userAge:19},\n{id:3,userName:Aaryansh,userAge:19},\n{id:4,userName:Rishi,userAge:19}\n]",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
