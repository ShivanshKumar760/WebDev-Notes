    {
      "id": "OPAgM3qIvcfTSahw4pWeH",
      "type": "text",
      "x": 370.4867459849084,
      "y": 67734.400704963,
      "width": 653.3995971679688,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
