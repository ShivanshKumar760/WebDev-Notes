    {
      "id": "EN3NVacbzgoQ1XnqZJSmg",
      "type": "text",
      "x": -725.1033334471526,
      "y": 28606.543061436583,
      "width": 3515.829847429576,
      "height": 452.2939020425073,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bbq",
      "roundness": null,
      "seed": 2112638802,
      "version": 469,
      "versionNonce": 410979986,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1730617899238,
      "link": null,
      "locked": false,
      "text": "The first argument, req, is shorthand for the request object with built-in properties to access data from the client side and facilitate HTTP requests\nThe res argument is the response object with built-in methods to send data to the client side through HTTP requests. The argument, next, is a function \nthat tells Express.js to continue on to the following middleware you have configured for your application.\n\nMiddleware has the ability to modify the req and res objects, run any code you wish, end the request and response cycle, and move onto the following functions.\n\nNote the order of your middleware, as invoking the next() function is required in each preceding middleware.\n\nNow that you’ve reviewed the three arguments that build a middleware, let’s look at how to assemble a custom middleware.",
      "fontSize": 40.203902403778415,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The first argument, req, is shorthand for the request object with built-in properties to access data from the client side and facilitate HTTP requests\nThe res argument is the response object with built-in methods to send data to the client side through HTTP requests. The argument, next, is a function \nthat tells Express.js to continue on to the following middleware you have configured for your application.\n\nMiddleware has the ability to modify the req and res objects, run any code you wish, end the request and response cycle, and move onto the following functions.\n\nNote the order of your middleware, as invoking the next() function is required in each preceding middleware.\n\nNow that you’ve reviewed the three arguments that build a middleware, let’s look at how to assemble a custom middleware.",
      "autoResize": true,
      "lineHeight": 1.25
    },
