    {
      "id": "SgKVUkqoRyFvGbpOBe-2Y",
      "type": "text",
      "x": 159.03937944213817,
      "y": 11133.79917794091,
      "width": 543.5093383789062,
      "height": 526.2217406159516,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
