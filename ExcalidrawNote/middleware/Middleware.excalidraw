        }
      ],
      "updated": 1730614749558,
      "link": null,
      "locked": false,
      "text": "A custom middleware which will\npush data into the in memory array \nif  not empty as when we hit a new route\nor refresh the same route whole \nserver reads it code froms top to bottom\nmeaning request body reset for every request",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A custom middleware which will\npush data into the in memory array \nif  not empty as when we hit a new route\nor refresh the same route whole \nserver reads it code froms top to bottom\nmeaning request body reset for every request",
      "autoResize": true,
      "lineHeight": 1.25
    },
