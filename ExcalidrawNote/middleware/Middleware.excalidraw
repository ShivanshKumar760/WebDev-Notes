      "seed": 411547214,
      "version": 449,
      "versionNonce": 938616718,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1730615377885,
      "link": null,
      "locked": false,
      "text": "Now this is a put method which will update the entire \nuser record so in this we are using a dynamic \nroute pr route paramete and extracting the id,\nand then searching for user once the user is find\nwe are stroing it in a variable this variable will \ncreate refrence to that object without creating new\ninstance of that object\n\nthen the new value which the user as added we need \nthat like userName and userAge and storing \nit in variable \n\nand then assigning  the new value \n\n\nbut the problem is as soon as we send userName and \ndata from a form or api tool\nour pushData() middleware will parse the incomming\nrequest as it is a global middleware mounted \nfor every route \n\nand it will push a new record into the user\nin memory data base ",
      "fontSize": 18.30336489098962,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Now this is a put method which will update the entire \nuser record so in this we are using a dynamic \nroute pr route paramete and extracting the id,\nand then searching for user once the user is find\nwe are stroing it in a variable this variable will \ncreate refrence to that object without creating new\ninstance of that object\n\nthen the new value which the user as added we need \nthat like userName and userAge and storing \nit in variable \n\nand then assigning  the new value \n\n\nbut the problem is as soon as we send userName and \ndata from a form or api tool\nour pushData() middleware will parse the incomming\nrequest as it is a global middleware mounted \nfor every route \n\nand it will push a new record into the user\nin memory data base ",
      "autoResize": true,
      "lineHeight": 1.25
    },
